---
export const prerender = false;

import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import MapIsland from '../../components/MapIsland';
import ChainNav from '../../components/ChainNav.astro';
import ReportLink from '../../components/ReportLink.astro';
import { getPlaceById, getApprovedPlaces } from '../../lib/db';
import { getImageUrl, buildR2Key } from '../../lib/r2';

const { id } = Astro.params;
if (!id) return Astro.redirect('/');

const place = await getPlaceById(env.DB, id);
if (!place) return new Response(null, { status: 404 });

const allPlaces = await getApprovedPlaces(env.DB);
const successor = allPlaces.find((p) => p.prev_place_id === id && !p.is_tombstoned);

const origin = Astro.url.origin;
const modalUrl =
  place.r2_key_prefix && !place.is_tombstoned
    ? getImageUrl(env, buildR2Key('approved', place.id, 'modal', 'jpeg'), origin)
    : null;
const thumbUrl =
  place.r2_key_prefix && !place.is_tombstoned
    ? getImageUrl(env, buildR2Key('approved', place.id, 'thumb', 'jpeg'), origin)
    : null;

const siteUrl = origin;

const jsonLd = !place.is_tombstoned
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      '@id': `${siteUrl}/place/${id}#article`,
      headline: place.place_name,
      description: place.sentence,
      author: { '@type': 'Person', name: place.contributor_name },
      datePublished: place.approved_at,
      image: modalUrl ?? undefined,
      url: `${siteUrl}/place/${id}`,
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${siteUrl}/#website`,
        name: 'LocalMatal',
        url: siteUrl,
      },
    }
  : undefined;
---

<Base
  title={place.is_tombstoned ? 'Removed place — LocalMatal' : `${place.place_name} — LocalMatal`}
  description={place.is_tombstoned ? undefined : place.sentence}
  ogImage={modalUrl ?? undefined}
  ogUrl={`${siteUrl}/place/${id}`}
  ogType={place.is_tombstoned ? 'website' : 'article'}
  articlePublishedTime={place.is_tombstoned ? undefined : place.approved_at}
  jsonLd={jsonLd}
>
  {
    place.is_tombstoned ? (
      <div class="tombstone" role="status">
        <p>This place has been removed.</p>
      </div>
    ) : (
      <article>
        {modalUrl && (
          <img
            src={modalUrl}
            alt={place.sentence}
            width={place.thumb_width ?? undefined}
            height={place.thumb_height ?? undefined}
            class="place-photo"
            loading="lazy"
          />
        )}
        <h1 class="place-name">{place.place_name}</h1>
        <p class="place-sentence">"{place.sentence}"</p>
        <p class="place-contributor">— {place.contributor_name}</p>
        <MapIsland mode="display" lat={place.lat} lng={place.lng} fuzzed={true} client:visible />
        <ReportLink placeId={place.id} />
      </article>
    )
  }

  <ChainNav prevId={place.prev_place_id} nextId={successor?.id ?? null} />
</Base>
