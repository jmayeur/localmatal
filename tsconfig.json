{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": ["src", "workers", "migrations"],
  "exclude": ["node_modules", "dist", ".astro"]
}
